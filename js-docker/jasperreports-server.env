JAVA_BASE_IMAGE=eclipse-temurin:11-jdk-jammy
JASPERREPORTS_SERVER_VERSION=8.0.0
JASPERREPORTS_SERVER_IMAGE_TAG=8.0.0
POSTGRES_JDBC_DRIVER_VERSION=42.2.14

# JasperReports repository connection.
DB_TYPE=postgresql
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jasperserver

# Tomcat runs HTTP inside the container; Caddy terminates TLS outside.
HTTP_PORT=8080
HTTPS_PORT=8443
JRS_HTTPS_ONLY=false

# Set this in Coolify to your public URL, for example:
# JRS_PUBLIC_URL=https://reports.example.com/jasperserver/

#
# Default web credentials after a minimal JasperReports import:
#   Admin: jasperadmin / jasperadmin
#   User:  joeuser / joeuser
#
